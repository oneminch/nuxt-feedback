{
  "name": "nuxt-feedback-workspace",
  "private": true,
  "scripts": {
    "docs": "pnpm --filter nuxt-feedback-docs dev",
    "docs:build": "pnpm --filter nuxt-feedback-docs build",
    "dev": "pnpm run docs",
    "build": "pnpm --filter @minch/nuxt-feedback prepack",
    "lint": "eslint --cache .",
    "release": "pnpm --filter @minch/nuxt-feedback release",
    "test": "pnpm --filter @minch/nuxt-feedback test",
    "test:types": "pnpm --filter @minch/nuxt-feedback exec vue-tsc --noEmit && pnpm --filter nuxt-feedback-docs exec vue-tsc --noEmit"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:shared",
    "eslint": "catalog:shared",
    "typescript": "catalog:shared",
    "vue-tsc": "catalog:shared"
  }
}
